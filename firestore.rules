rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must match scorerEmail in config.js
    function isScorer() {
      return request.auth != null && request.auth.token.email == 'scorer@masconcup.app';
    }
    function matchData(mid) {
      return get(/databases/$(database)/documents/matches/$(mid)).data;
    }

    // Teams, squads and settings: everyone reads, only the scorer writes
    match /tournament/{docId} {
      allow read: if true;
      allow write: if isScorer();
    }

    // Matches with every ball: everyone reads, only the scorer writes
    match /matches/{mid} {
      allow read: if true;
      allow write: if isScorer();
    }

    // Fan predictions: one field per fan (their anonymous id) on one document per match.
    // A fan may set only their own pick, only for one of the two teams, only before the first ball.
    match /polls/{mid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([request.auth.uid])
        && matchData(mid).status in ['scheduled', 'setup']
        && request.resource.data[request.auth.uid] in [matchData(mid).a, matchData(mid).b];
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid])
        && matchData(mid).status in ['scheduled', 'setup']
        && request.resource.data[request.auth.uid] in [matchData(mid).a, matchData(mid).b];
      allow delete: if isScorer();
    }

    // Fantasy teams: one document per phone (anonymous uid). Name + exactly 13 player ids.
    // Anyone can read (leaderboard). Create/update only by that same phone, only before the first ball.
    function noBallBowled() {
      return !exists(/databases/$(database)/documents/meta/lock);
    }
    match /fantasy/{fid} {
      allow read: if true;
      allow create, update: if isScorer() || (request.auth != null && fid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30
        && request.resource.data.p is list && request.resource.data.p.size() == 13
        && noBallBowled());
      // Substitution window (opened/closed by the scorer in meta/subs): that phone may save its phase-k team
      // (p{k}, c{k}, vc{k}) with 13 players and at most 2 changed from the team it had before the window.
      allow update: if request.auth != null && fid == request.auth.uid && subsOpen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([subKey('p'), subKey('c'), subKey('vc'), 'at'])
        && request.resource.data[subKey('p')] is list && request.resource.data[subKey('p')].size() == 13
        && request.resource.data[subKey('p')].toSet().difference(subBase().toSet()).size() <= 2;
      allow delete: if isScorer();
    }
    function subsDoc() {
      return get(/databases/$(database)/documents/meta/subs).data;
    }
    function subsOpen() {
      return exists(/databases/$(database)/documents/meta/subs) && subsDoc().open == true && subsDoc().phase in [1, 2];
    }
    function subKey(f) {
      return f + string(subsDoc().phase);
    }
    // The team before this window: original picks for window 1; for window 2, the window-1 team if one was saved
    function subBase() {
      return subsDoc().phase == 1 ? resource.data.p : resource.data.get('p1', resource.data.p);
    }
    // Prediction-league names: each phone writes its own, everyone reads
    match /fans/{fid} {
      allow read: if true;
      allow create, update: if request.auth != null && fid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30;
      allow delete: if isScorer();
    }
    match /meta/{docId} {
      allow read: if true;
      allow write: if isScorer();
    }

    // ===== Kids tournament: same rules on k-prefixed collections =====
    function kMatchData(mid) {
      return get(/databases/$(database)/documents/kmatches/$(mid)).data;
    }
    // Teams, squads and settings: everyone reads, only the scorer writes
    match /ktournament/{docId} {
      allow read: if true;
      allow write: if isScorer();
    }

    // Matches with every ball: everyone reads, only the scorer writes
    match /kmatches/{mid} {
      allow read: if true;
      allow write: if isScorer();
    }

    // Fan predictions: one field per fan (their anonymous id) on one document per match.
    // A fan may set only their own pick, only for one of the two teams, only before the first ball.
    match /kpolls/{mid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([request.auth.uid])
        && kMatchData(mid).status in ['scheduled', 'setup']
        && request.resource.data[request.auth.uid] in [kMatchData(mid).a, kMatchData(mid).b];
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid])
        && kMatchData(mid).status in ['scheduled', 'setup']
        && request.resource.data[request.auth.uid] in [kMatchData(mid).a, kMatchData(mid).b];
      allow delete: if isScorer();
    }

    // Fantasy teams: one document per phone (anonymous uid). Name + exactly 13 player ids.
    // Anyone can read (leaderboard). Create/update only by that same phone, only before the first ball.
    function kNoBallBowled() {
      return !exists(/databases/$(database)/documents/kmeta/lock);
    }
    match /kfantasy/{fid} {
      allow read: if true;
      allow create, update: if isScorer() || (request.auth != null && fid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30
        && request.resource.data.p is list && request.resource.data.p.size() == 13
        && kNoBallBowled());
      allow delete: if isScorer();
    }
    // Prediction-league names: each phone writes its own, everyone reads
    match /kfans/{fid} {
      allow read: if true;
      allow create, update: if request.auth != null && fid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30;
      allow delete: if isScorer();
    }
    match /kmeta/{docId} {
      allow read: if true;
      allow write: if isScorer();
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
